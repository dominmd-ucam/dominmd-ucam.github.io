# Copia este archivo a .env y rellénalo. No lo subas a git.

# Orígenes que pueden usar la API desde el navegador (separados por comas).
ALLOWED_ORIGINS=https://dominmd-ucam.github.io

# Token para moderar (mínimo 24 caracteres). Genera uno con:  openssl rand -hex 24
ADMIN_TOKEN=

# Cabecera con la IP real del visitante. Sin esto, tras un túnel todos parecen la misma IP
# y el límite de envíos se aplicaría a todo el mundo a la vez.
#   Cloudflare Tunnel:  cf-connecting-ip
#   Otro proxy:         x-forwarded-for   (comprueba con /admin/api/whoami)
IP_HEADER=cf-connecting-ip

# Solo con Cloudflare Tunnel (perfil "cloudflare"): token del túnel.
TUNNEL_TOKEN=

# Solo con Tailscale con nombre propio (perfil "tailscale"): clave de autenticación y nombre del nodo.
# La clave se crea en https://login.tailscale.com/admin/settings/keys (Generate auth key, sin "Reusable").
TS_AUTHKEY=
TS_HOSTNAME=portfolio-api

# Avisos de mensajes nuevos (opcionales; deja vacío lo que no uses).
DISCORD_WEBHOOK_URL=
NTFY_URL=

# Visitantes fantasma: on | off, y límite de conexiones.
PRESENCE=on
PRESENCE_MAX=60
PRESENCE_MAX_PER_IP=4

LOG_LEVEL=info
